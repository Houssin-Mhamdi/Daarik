generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

enum Role {
  CUSTOMER
  COOK
  ADMIN
}

enum CookStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum DishStatus {
  LIVE
  PAUSED
  DRAFT
}

enum OrderStatus {
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  IDEAL
  CARD
  BANCONTACT
}

/// Lifecycle of the money for an order. Nothing is PAID until a verified
/// Stripe webhook confirms it; the frontend can never set this.
enum PaymentStatus {
  REQUIRES_PAYMENT
  PROCESSING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  DISPUTED
  FAILED
  CANCELLED
}

/// Daarik's own compliance gate, deliberately separate from Stripe KYC.
enum ComplianceStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum StripeAccountStatus {
  NONE
  PENDING
  REQUIREMENTS_DUE
  RESTRICTED
  ENABLED
  DISABLED
}

/// Transfer = Daarik releasing one order's earnings into the cook's Stripe
/// balance. Stripe's own bank payout is modelled by `Payout`.
enum TransferStatus {
  PENDING
  CREATED
  FAILED
  REVERSED
}

enum PayoutStatus {
  SCHEDULED
  IN_TRANSIT
  PAID
  FAILED
  CANCELED
}

enum DisputeStatus {
  OPEN
  REVIEW
  WON
  LOST
  RESOLVED
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  refreshTokenHash String?
  role             Role     @default(CUSTOMER)
  name             String
  firstName        String?
  phone            String?
  avatar           String?  @default("/img/user-sarah.jpg")
  address          String?
  postcode         String?
  city             String?
  preferredLang    String   @default("nl")
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cookProfile      CookProfile?
  cookApplications CookApplication[]
  cartItems        CartItem[]
  favoriteDishes   FavoriteDish[]
  favoriteCooks    FavoriteCook[]
  orders           Order[]           @relation("CustomerOrders")
  reviews          Review[]
  notifications    Notification[]
  supportTickets   SupportTicket[]

  @@index([email])
  @@index([role])
}

model CookProfile {
  id            String     @id @default(cuid())
  slug          String     @unique
  userId        String     @unique
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  kitchenName   Json?
  avatar        String     @default("/img/cook-rana.jpg")
  cover         String     @default("/img/couscous.jpg")
  city          String
  area          Json
  cuisineIds    String[]
  rating        Float      @default(5.0)
  reviewCount   Int        @default(0)
  verified      Boolean    @default(false)
  status        CookStatus @default(PENDING)
  languages     String[]
  bio           Json
  since         String     @default("2026")
  ordersCount   Int        @default(0)
  response      Json
  pickupArea    Json
  specialties   Json
  /// Exact pickup instructions & door details — NEVER exposed on public endpoints; only returned on paid/confirmed customer orders
  instructions  Json
  privateAddress String?
  /// Kitchen map position. Public endpoints only expose it rounded (~1 km).
  latitude      Float?
  longitude     Float?
  yearsCooking  Int        @default(1)
  kitchenOpen   Boolean    @default(true)
  payoutDay     String     @default("monday")

  // ---- Stripe Connect (payout routing only; no identity data stored here) ----
  /// Connected account id (`acct_...`). The only Stripe identifier we persist.
  stripeAccountId        String?             @unique
  stripeAccountStatus    StripeAccountStatus @default(NONE)
  stripeChargesEnabled   Boolean             @default(false)
  stripePayoutsEnabled   Boolean             @default(false)
  /// Requirement keys Stripe says are still missing, e.g. ["individual.id_number"].
  stripeRequirementsDue  String[]            @default([])
  stripeDisabledReason   String?
  stripeSyncedAt         DateTime?
  /// Display-safe bank details only. Full IBAN/BSN never leave Stripe.
  bankName               String?
  ibanLast4              String?

  // ---- Daarik compliance (NOT covered by Stripe KYC) ----
  complianceStatus       ComplianceStatus    @default(NOT_STARTED)
  complianceNote         String?
  complianceCheckedAt    DateTime?
  complianceCheckedBy    String?
  kvkNumber              String?
  nvwaRegistered         Boolean             @default(false)

  /// Per-cook override for the platform hold period (null = use platform default).
  payoutHoldDays         Int?

  maxPortionsPerDay Int    @default(20)
  availableDays String[]   @default(["fri-30", "sat-31", "sun-01"])
  availableSlots String[]  @default(["17:00", "17:30", "18:00", "18:30"])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  dishes        Dish[]
  orders        Order[]
  reviews       Review[]
  payouts       Payout[]
  transfers     Transfer[]
  favoritedBy   FavoriteCook[]
  disputes      Dispute[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([city(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([status])
}

model CookApplication {
  id                String            @id @default(cuid())
  userId            String?
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  name              String
  email             String
  phone             String
  city              String
  area              String?
  cuisine           String
  specialties       String?
  bio               String?
  yearsCooking      Int               @default(1)
  documentsCount    Int               @default(3)
  documents         Json?
  hygieneCertificate Boolean          @default(true)
  idVerified        Boolean           @default(true)
  kitchenPhotos     String[]          @default([])
  status            ApplicationStatus @default(PENDING)
  reviewerNotes     String?
  submittedAt       DateTime          @default(now())
  reviewedAt        DateTime?

  @@index([status])
}

model Dish {
  id           String     @id @default(cuid())
  slug         String     @unique
  cookId       String
  cook         CookProfile @relation(fields: [cookId], references: [id], onDelete: Cascade)
  name         Json
  desc         Json
  image        String
  price        Float
  cuisineId    String
  rating       Float      @default(5.0)
  reviewCount  Int        @default(0)
  serves       Int        @default(1)
  portions     Int        @default(8)
  portionsLeft Int        @default(8)
  allergens    String[]
  dietary      String[]
  ingredients  Json
  pickup       String[]
  /// Per-weekday pickup windows, e.g. { "mon": ["17:00","18:00"] }
  pickupWindows Json?
  /// Allow ordering for pickup today when the customer is inside the radius.
  sameDayPickup Boolean @default(false)
  sameDayRadiusKm Int   @default(5)
  /// Allow ordering for pickup tomorrow.
  nextDayPickup Boolean @default(true)
  featured     Boolean    @default(false)
  weekend      Boolean    @default(false)
  family       Boolean    @default(false)
  badge        Json?
  prepTime     Json
  status       DishStatus @default(LIVE)
  reported     Boolean    @default(false)
  reportReason String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  cartItems    CartItem[]
  orderItems   OrderItem[]
  reviews      Review[]
  favoritedBy  FavoriteDish[]

  /// Lowercased name/description/cuisine used for search (see buildDishSearchText).
  searchText   String     @default("")

  @@index([cookId])
  @@index([cuisineId])
  @@index([status])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

model PickupOption {
  id       String   @id
  day      Json
  shortDay Json
  date     String
  slots    String[]
}

model CartItem {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dishId     String
  dish       Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  qty        Int      @default(1)
  pickupSlot String?
  pickupTime String?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, dishId])
  @@index([userId])
}

model FavoriteDish {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dishId    String
  dish      Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, dishId])
}

model FavoriteCook {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cookId    String
  cook      CookProfile @relation(fields: [cookId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([userId, cookId])
}

model Order {
  id            String        @id @default(cuid())
  code          String        @unique
  customerId    String
  customer      User          @relation("CustomerOrders", fields: [customerId], references: [id])
  cookId        String
  cook          CookProfile   @relation(fields: [cookId], references: [id])
  status        OrderStatus   @default(CONFIRMED)
  pickup        String
  pickupTime    String
  /// All money is stored as integer euro cents. Never Float.
  subtotalCents    Int
  serviceFeeCents  Int           @default(150)
  commissionCents  Int
  cookNetCents     Int
  totalCents       Int
  currency         String        @default("eur")

  note          Json?
  customerName  String
  customerEmail String
  customerPhone String
  paymentMethod PaymentMethod @default(IDEAL)

  // ---- Stripe ----
  paymentStatus         PaymentStatus @default(REQUIRES_PAYMENT)
  stripeCheckoutSessionId String?     @unique
  stripePaymentIntentId String?       @unique
  stripeChargeId        String?       @unique
  /// What Stripe actually charged us in processing fees (from the balance tx).
  stripeFeeCents        Int           @default(0)
  refundedCents         Int           @default(0)
  paidAt                DateTime?
  failedReason          String?

  // ---- Earnings release ----
  completedAt       DateTime?
  /// Money may be released on/after this instant. Null until the order completes.
  transferEligibleAt DateTime?
  /// Set while a dispute is open so the release job skips this order.
  disputeBlocked    Boolean   @default(false)

  reviewed      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items         OrderItem[]
  reviews       Review[]
  disputes      Dispute[]
  transfers     Transfer[]
  refunds       Refund[]

  @@index([customerId])
  @@index([cookId])
  @@index([status])
  @@index([code(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([customerName(ops: raw("gin_trgm_ops"))], type: Gin)
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dishId    String
  dish      Dish   @relation(fields: [dishId], references: [id])
  qty       Int
  /// Price snapshot at purchase time, in euro cents.
  unitPriceCents Int
  name      Json
}

model Review {
  id         String      @id @default(cuid())
  orderId    String?
  order      Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerId String?
  customer   User?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cookId     String
  cook       CookProfile @relation(fields: [cookId], references: [id], onDelete: Cascade)
  dishId     String?
  dish       Dish?       @relation(fields: [dishId], references: [id], onDelete: SetNull)
  author     String
  initials   String
  rating     Int
  date       Json
  text       Json
  createdAt  DateTime    @default(now())

  @@index([cookId])
  @@index([dishId])
}

/// A Stripe bank payout to the cook's external account. Populated only from
/// `payout.*` webhooks, so a payout is never marked PAID before Stripe says so.
model Payout {
  id              String       @id @default(cuid())
  code            String       @unique
  cookId          String
  cook            CookProfile  @relation(fields: [cookId], references: [id], onDelete: Cascade)

  /// Stripe payout id (`po_...`). Null until the webhook arrives.
  stripePayoutId  String?      @unique
  amountCents     Int
  currency        String       @default("eur")

  /// Statement snapshot for the admin UI.
  period          String
  grossCents      Int          @default(0)
  commissionCents Int          @default(0)
  ordersCount     Int          @default(0)

  status          PayoutStatus @default(SCHEDULED)
  automatic       Boolean      @default(true)
  arrivalDate     DateTime?
  failureCode     String?
  failureMessage  String?
  paidAt          DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([cookId])
  @@index([status])
}

/// One order's earnings released from the Daarik platform balance into the
/// cook's Stripe balance. Created by the release job, never by a request.
model Transfer {
  id                   String         @id @default(cuid())
  orderId              String
  order                Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cookId               String
  cook                 CookProfile    @relation(fields: [cookId], references: [id], onDelete: Cascade)

  amountCents          Int
  currency             String         @default("eur")
  status               TransferStatus @default(PENDING)

  stripeTransferId     String?        @unique
  stripeSourceChargeId String?
  reversedCents        Int            @default(0)
  failureReason        String?

  /// Unique retry key, e.g. `transfer:ord_123`, so a retry is never double-paid.
  idempotencyKey       String         @unique
  createdBy            String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([cookId])
  @@index([status])
  @@index([orderId])
}

model Refund {
  id                 String   @id @default(cuid())
  orderId            String
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stripeRefundId     String   @unique
  amountCents        Int
  reason             String?
  status             String   @default("succeeded")
  reversedTransferCents Int   @default(0)
  createdBy          String?
  createdAt          DateTime @default(now())

  @@index([orderId])
}

/// Raw Stripe events, used for idempotency and audit. `stripeEventId` is the
/// dedupe key; a duplicate delivery returns 200 without reprocessing.
model WebhookEvent {
  id            String    @id @default(cuid())
  stripeEventId String    @unique
  type          String
  payload       Json
  processedAt   DateTime?
  attempts      Int       @default(0)
  error         String?
  createdAt     DateTime  @default(now())

  @@index([type])
  @@index([createdAt])
}

model Dispute {
  id             String        @id @default(cuid())
  code           String        @unique
  orderId        String?
  order          Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderCode      String
  cookId         String?
  cook           CookProfile?  @relation(fields: [cookId], references: [id], onDelete: SetNull)
  customerName   String
  cookName       String
  reason         String
  customerNote   String?
  resolutionNote String?
  amountCents    Int           @default(0)
  refundCents    Int?

  stripeDisputeId  String?      @unique
  stripeChargeId   String?
  stripePaymentIntentId String?
  evidenceDueBy    DateTime?
  /// Stripe dispute status string as delivered by the webhook.
  stripeStatus     String?
  transferReversed Boolean      @default(false)

  status         DisputeStatus @default(OPEN)
  openedAt       DateTime      @default(now())
  resolvedAt     DateTime?

  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     Json
  body      Json
  timeLabel Json?
  unread    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String?
  orderCode String?
  message   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
}

model PlatformSetting {
  id                  String   @id @default("singleton")
  platformName        String   @default("Daarik")
  region              String   @default("NL")
  currency            String   @default("EUR")
  timezone            String   @default("Europe/Amsterdam")

  // ---- Pricing ----
  /// Customer-facing flat service fee, in euro cents.
  serviceFeeCents     Int      @default(150)
  /// Kept for backwards compatibility with older clients; mirrors serviceFeeCents/100.
  serviceFee          Float    @default(1.5)
  /// Commission as a fraction of the base, e.g. 0.15.
  commissionRate      Float    @default(0.15)
  /// Optional fixed commission added on top, in euro cents.
  commissionFixedCents Int     @default(0)
  /// `SUBTOTAL` (food only) or `TOTAL` (food + service fee).
  commissionBase      String   @default("SUBTOTAL")
  /// Smallest order we accept, in euro cents. Protects against fee-destroying orders.
  minOrderCents       Int      @default(800)

  // ---- Stripe fees ----
  /// `PLATFORM` = Daarik absorbs processing fees out of commission + service fee.
  stripeFeeBearer     String   @default("PLATFORM")

  // ---- Payout policy ----
  /// Days after completion before earnings may be released.
  payoutHoldDays      Int      @default(7)
  /// `DAILY` | `WEEKLY` | `MONTHLY` | `MANUAL` — applied to each connected account.
  payoutInterval      String   @default("WEEKLY")
  payoutWeeklyAnchor  String   @default("monday")
  payoutMonthlyAnchor Int      @default(1)

  // ---- Compliance / invoicing ----
  vatRateBps          Int      @default(2100)
  kvkNumber           String?
  supportEmail        String   @default("hello@daarik.nl")

  requireVerification Boolean  @default(true)
  autoApproveCooks    Boolean  @default(false)
  maintenanceMode     Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}
